---
import type { ContentEntry } from "emdash";
import type { Page } from "../../emdash-env";
import MarketingBlocks from "./MarketingBlocks.astro";

interface Props {
	page: ContentEntry<Page>;
	/** The heading shown when the page has no hero. Defaults to the page title. */
	heading?: string;
}

const { page, heading } = Astro.props;
const title = heading ?? page.data.title;
const titleEdit = heading === undefined ? page.edit.title : {};
const blocks = page.data.content ?? [];
const hasHero = blocks.some((block) => block._type === "marketing_hero");
---

{
	blocks.length > 0 ? (
		<>
			{!hasHero && (
				<header class="wrap pt-opening">
					<h1 class="headline max-w-title" {...titleEdit}>
						{title}
					</h1>
				</header>
			)}
			<div data-blocks class="flex flex-col" {...page.edit.content}>
				<MarketingBlocks value={blocks} />
			</div>
		</>
	) : (
		<section class="wrap empty-state">
			<h1 class="headline">{title}</h1>
			{Astro.locals.user && (
				<>
					<p class="lead">This page has no blocks yet. Add some in the editor, then publish.</p>
					<div class="mt-3 flex flex-wrap justify-center gap-2.5">
						<a href={`/_emdash/admin/content/pages/${page.data.id}`} class="btn btn-lg btn-primary">
							Edit page
						</a>
					</div>
				</>
			)}
		</section>
	)
}

---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type TestimonialsBlock = Extract<PageContentBlock, { _type: "marketing_testimonials" }>;
type Props = BlockComponentProps<TestimonialsBlock>;

const WHITESPACE = /\s+/;

function getInitials(name: string) {
	const letters = name
		.trim()
		.split(WHITESPACE)
		.map((word) => [...word][0] ?? "");
	const ends = letters.length > 1 ? [letters[0], letters.at(-1)] : letters;
	return ends.join("").toUpperCase();
}

const { value } = Astro.props;
const { anchor_id, headline } = value;
const [featured, ...others] = value.testimonials.map((testimonial) => ({
	...testimonial,
	initials: getInitials(testimonial.author),
	attribution: [testimonial.role, testimonial.company].filter(Boolean).join(", "),
}));
---

<section id={anchor_id || undefined} class="wrap scroll-mt-22 py-section-half">
	{headline && <h2 class="eyebrow mb-6 flex justify-center leading-copy tracking-normal">{headline}</h2>}
	{
		featured && (
			<figure class="mx-auto max-w-featured text-center">
				<span
					class="block h-half-em font-serif text-mark/none text-secondary-600 dark:text-secondary-400"
					aria-hidden="true">“</span
				>
				<blockquote class="display space-y-paragraph text-quote/quote tracking-quote">
					{toParagraphs(featured.quote).map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</blockquote>
				<figcaption class="mt-8 inline-flex items-center gap-3 text-start text-meta font-medium">
					{featured.avatar ? (
						<Image
							image={featured.avatar}
							alt=""
							width={44}
							height={44}
							class="h-11! w-11 max-w-none! flex-none rounded-full object-cover"
						/>
					) : (
						<span
							class="grid size-11 flex-none place-items-center rounded-full bg-tertiary-400 text-initials font-medium tracking-mark text-neutral-400 inset-ring inset-ring-tertiary-600 dark:bg-neutral-950 dark:text-neutral-100 dark:inset-ring-neutral-600"
							aria-hidden="true"
						>
							{featured.initials}
						</span>
					)}
					<span>
						{featured.author}
						{featured.attribution && " "}
						{featured.attribution && (
							<span class="block text-small font-normal text-neutral-300 dark:text-neutral-200">
								{featured.attribution}
							</span>
						)}
					</span>
				</figcaption>
			</figure>
		)
	}
	{
		others.length > 0 && (
			<div class="mt-quotes grid grid-cols-quotes gap-4">
				{others.map((testimonial) => (
					<figure class="card flex flex-col justify-between p-8">
						<blockquote class="quoted space-y-paragraph text-lead/note text-pretty">
							{toParagraphs(testimonial.quote).map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</blockquote>
						<figcaption class="mt-7 inline-flex items-center gap-3 text-start text-meta font-medium">
							{testimonial.avatar ? (
								<Image
									image={testimonial.avatar}
									alt=""
									width={44}
									height={44}
									class="h-11! w-11 max-w-none! flex-none rounded-full object-cover"
								/>
							) : (
								<span
									class="grid size-11 flex-none place-items-center rounded-full bg-tertiary-400 text-initials font-medium tracking-mark text-neutral-400 inset-ring inset-ring-tertiary-600 dark:bg-neutral-950 dark:text-neutral-100 dark:inset-ring-neutral-600"
									aria-hidden="true"
								>
									{testimonial.initials}
								</span>
							)}
							<span>
								{testimonial.author}
								{testimonial.attribution && " "}
								{testimonial.attribution && (
									<span class="block text-small font-normal text-neutral-300 dark:text-neutral-200">
										{testimonial.attribution}
									</span>
								)}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		)
	}
</section>

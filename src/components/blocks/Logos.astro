---
import { Icon } from "astro-iconset/components";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type LogosBlock = Extract<PageContentBlock, { _type: "marketing_logos" }>;
type Props = BlockComponentProps<LogosBlock>;

const { value } = Astro.props;
const { anchor_id, headline, logos } = value;
---

<section class="scroll-mt-22 py-section-half" id={anchor_id || undefined}>
	{
		headline && (
			<h2 class="wrap mb-7 text-center font-sans text-small/copy font-normal tracking-normal text-neutral-300 dark:text-neutral-200">
				{headline}
			</h2>
		)
	}
	<div class="relative">
		<div class="marquee" style={`--logo-count: ${Math.max(logos.length, 6)}`}>
			{[false, true].map((duplicate) => (
				<ul class="marquee-group" role="list" aria-hidden={duplicate ? "true" : undefined}>
					{logos.map((logo) => (
						<li>
							{logo.logo ? (
								<Image
									image={logo.logo}
									alt={logo.name}
									sizes="140px"
									class="h-7! w-auto max-w-35! object-contain opacity-72 grayscale"
								/>
							) : (
								logo.name
							)}
						</li>
					))}
				</ul>
			))}
		</div>
		<button
			type="button"
			class="marquee-toggle group"
			aria-pressed="false"
			aria-label="Pause the logo animation"
		>
			<Icon name="ph:pause" aria-hidden="true" class="group-aria-pressed:hidden" />
			<Icon name="ph:play" aria-hidden="true" class="group-not-aria-pressed:hidden" />
		</button>
	</div>
</section>

<script>
	for (const toggle of document.querySelectorAll<HTMLButtonElement>(".marquee-toggle")) {
		const marquee = toggle.parentElement?.querySelector<HTMLElement>(".marquee");
		if (!marquee) continue;
		toggle.addEventListener("click", () => {
			const paused = toggle.getAttribute("aria-pressed") !== "true";
			toggle.setAttribute("aria-pressed", String(paused));
			marquee.toggleAttribute("data-paused", paused);
		});
	}
</script>

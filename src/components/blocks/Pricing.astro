---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type PricingBlock = Extract<PageContentBlock, { _type: "marketing_pricing" }>;
type Props = BlockComponentProps<PricingBlock>;

const { value } = Astro.props;
const { anchor_id, headline, plans: rawPlans } = value;
const PlanHeading = headline ? "h3" : "h2";

const plans = rawPlans.map((plan) => ({
	...plan,
	// Plans stored before the badge field existed have no badge value and keep their "Most popular" badge; an emptied field hides it.
	badge:
		plan.badge == null ? (plan.highlighted ? "Most popular" : undefined) : plan.badge.trim() || undefined,
	description: toParagraphs(plan.description),
	features: (plan.features ?? "")
		.split("\n")
		.map((s) => s.trim())
		.filter(Boolean),
	cta: {
		label: plan.cta_label,
		url: sanitizeHref(plan.cta_url),
	},
}));
---

<section id={anchor_id || undefined} class="wrap scroll-mt-22 py-section-half">
	{
		headline && (
			<header class="mx-auto mb-header max-w-intro text-center">
				<h2 class="headline">{headline}</h2>
			</header>
		)
	}
	<ul
		class:list={[
			"grid grid-cols-plans items-stretch gap-4",
			{ "mx-auto max-w-single": plans.length === 1 },
		]}
		role="list"
	>
		{
			plans.map((plan) => {
				const soft = plan.highlighted
					? "text-tertiary-300/80"
					: "text-neutral-400 dark:text-neutral-100";
				return (
					<li
						class:list={[
							"card flex flex-col rounded-plan p-8",
							{
								"bg-primary-700 text-tertiary-300 focus-ring-tertiary-300 dark:bg-primary-950":
									plan.highlighted,
							},
						]}
					>
						{/* min-h-6 is the badge height, so prices line up across plans with and without a badge */}
						<div class="flex min-h-6 flex-wrap items-center justify-between gap-x-3 gap-y-2">
							<PlanHeading class:list={["text-meta/label tracking-normal", soft]}>
								{plan.name}
							</PlanHeading>
							{plan.badge && (
								<span
									class:list={[
										"ms-auto inline-flex h-6 items-center rounded-pill px-2.5 text-tag font-medium whitespace-nowrap",
										plan.highlighted
											? "bg-white/12 text-tertiary-300"
											: "bg-tertiary-400 text-neutral-400 dark:bg-neutral-950 dark:text-neutral-100",
									]}
								>
									{plan.badge}
								</span>
							)}
						</div>
						<p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
							<span class="display text-price/none tabular-nums">{plan.price}</span>
							{plan.period && " "}
							{plan.period && (
								<span
									class:list={[
										"text-small",
										plan.highlighted
											? "text-tertiary-300/80"
											: "text-neutral-300 dark:text-neutral-200",
									]}
								>
									{plan.period}
								</span>
							)}
						</p>
						{plan.description.map((paragraph) => (
							<p class:list={["mt-4 text-meta/plan text-pretty", soft]}>{paragraph}</p>
						))}
						{plan.features.length > 0 && (
							<ul class="mt-7 grid gap-3" role="list">
								{plan.features.map((feature) => (
									<li class:list={["flex items-start gap-3 text-detail", soft]}>
										<span
											class:list={[
												"mt-px grid size-5.5 flex-none place-items-center rounded-full text-small",
												plan.highlighted
													? "bg-white/12 text-tertiary-300"
													: "text-secondary-600 dark:text-secondary-400",
											]}
											aria-hidden="true"
										>
											<Icon name="ph:check" />
										</span>
										{feature}
									</li>
								))}
							</ul>
						)}
						<div class="mt-auto pt-8">
							<a
								href={plan.cta.url}
								class:list={[
									"btn btn-lg w-full",
									plan.highlighted ? "btn-light" : "btn-secondary",
								]}
							>
								{plan.cta.label}
							</a>
						</div>
					</li>
				);
			})
		}
	</ul>
</section>

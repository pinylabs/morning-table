---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, image, image_caption, centered } =
	value;

const eyebrowUrl = value.eyebrow_url ? sanitizeHref(value.eyebrow_url) : undefined;
const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	data-hero={image ? "photo" : "plain"}
	class:list={[
		"relative isolate scroll-mt-22",
		image
			? "shade-hero mb-section-half grid min-h-hero items-end overflow-hidden text-tertiary-100 focus-ring-tertiary-100 max-md:min-h-150"
			: "pt-opening pb-section-half",
	]}
>
	{
		image && (
			<div class="photo-fill hero-settle absolute inset-0 -z-2">
				<Image image={image} priority sizes="100vw" />
			</div>
		)
	}
	<div
		class:list={[
			"wrap",
			image && "pt-35 pb-11 text-shadow-photo max-md:pt-30 max-md:pb-9",
			{ "text-center": centered },
		]}
	>
		{
			eyebrow && eyebrowUrl && (
				<a
					href={eyebrowUrl}
					class:list={[
						"rise inline-flex items-center gap-2.5 text-label font-medium tracking-label uppercase underline decoration-transparent underline-offset-6 transition-colors duration-200 hover:decoration-current",
						image ? "text-tertiary-100" : "text-secondary-600 dark:text-secondary-400",
					]}
				>
					{eyebrow}
					<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
				</a>
			)
		}
		{
			eyebrow && !eyebrowUrl && (
				<p
					class:list={[
						"rise inline-flex items-center gap-2.5 text-label font-medium tracking-label uppercase",
						image ? "text-tertiary-100" : "text-secondary-600 dark:text-secondary-400",
					]}
				>
					{eyebrow}
				</p>
			)
		}
		<h1
			class:list={[
				"rise max-w-headline tracking-title wrap-break-word",
				image ? "text-hero/title" : "text-headline/headline font-normal",
				{ "mt-4.5": eyebrow, "mx-auto": centered },
			]}
			style="--rise-index: 1"
		>
			{headline}
		</h1>
		{
			image && image_caption && (
				<p
					class="rise mt-2.5 text-meta font-semibold tracking-nav uppercase"
					style="--rise-index: 2"
				>
					{image_caption}
				</p>
			)
		}
		{
			(subheadline || primaryCta || secondaryCta) && (
				<div
					class:list={[
						"rise mt-5.5 grid gap-x-8 gap-y-4.5",
						centered
							? "grid-cols-1 items-end justify-items-center max-md:items-start"
							: "grid-cols-row items-end max-md:grid-cols-1 max-md:items-start",
					]}
					style="--rise-index: 3"
				>
					{subheadline && (
						<p
							class:list={[
								"lead max-w-lead text-body",
								{ "text-tertiary-100/90": image, "mx-auto": centered },
							]}
						>
							{subheadline}
						</p>
					)}
					{(primaryCta || secondaryCta) && (
						<div class:list={["flex flex-wrap gap-2.5", { "justify-center": centered }]}>
							{primaryCta && (
								<a
									href={primaryCta.url}
									class:list={["btn btn-lg", image ? "btn-light" : "btn-primary"]}
								>
									{primaryCta.label}
								</a>
							)}
							{secondaryCta && (
								<a
									href={secondaryCta.url}
									class:list={["btn btn-lg", image ? "btn-glass" : "btn-secondary"]}
								>
									{secondaryCta.label}
								</a>
							)}
						</div>
					)}
				</div>
			)
		}
	</div>
</section>

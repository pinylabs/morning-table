---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type CTABlock = Extract<PageContentBlock, { _type: "marketing_cta" }>;
type Props = BlockComponentProps<CTABlock>;

const { value } = Astro.props;
const { anchor_id, headline, image } = value;

const paragraphs = toParagraphs(value.body);
const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={[
		"relative isolate mx-auto my-section-half grid w-full scroll-mt-22 overflow-hidden rounded-sheet bg-primary-700 focus-ring-tertiary-300 dark:bg-primary-950",
		image
			? "settle shade-cta min-h-cta items-end text-tertiary-100 max-md:min-h-140"
			: "items-center text-center text-tertiary-300 dark:inset-ring dark:inset-ring-neutral-600",
	]}
>
	{
		image && (
			<div class="photo-fill absolute inset-0 -z-2">
				<Image image={image} alt="" sizes="(max-width: 960px) 1000px, min(100vw, 1680px)" />
			</div>
		)
	}
	<div class:list={["wrap", image ? "pt-16 pb-12 text-shadow-photo max-md:pt-10 max-md:pb-9" : "py-band"]}>
		<h2
			class:list={["display max-w-headline text-band-wide/heading", { "mx-auto": !image }]}
		>
			{headline}
		</h2>
		{
			paragraphs.map((paragraph) => (
				<p
					class:list={[
						"mt-3.5 max-w-copy text-body/copy",
						image ? "text-tertiary-100/88" : "mx-auto text-tertiary-300/80",
					]}
				>
					{paragraph}
				</p>
			))
		}
		{
			(primaryCta || secondaryCta) && (
				<div class:list={["mt-7.5 flex flex-wrap gap-2.5", { "justify-center": !image }]}>
					{primaryCta && (
						<a href={primaryCta.url} class="btn btn-lg btn-light">
							{primaryCta.label}
						</a>
					)}
					{secondaryCta && (
						<a href={secondaryCta.url} class="btn btn-lg btn-glass">
							{secondaryCta.label}
						</a>
					)}
				</div>
			)
		}
	</div>
</section>

---
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value, blockKey } = Astro.props;
const { anchor_id, headline, subheadline, items } = value;
const hasIntro = Boolean(headline || subheadline);
---

<section
	id={anchor_id || undefined}
	class:list={[
		"wrap grid scroll-mt-22 items-start gap-columns py-section-half",
		{ "grid-cols-menu max-md:grid-cols-1": hasIntro },
	]}
>
	{
		hasIntro && (
			<div class="sticky top-28 max-md:static">
				{headline && <h2 class="headline">{headline}</h2>}
				{subheadline && (
					<p
						class:list={[
							"max-w-lede text-body/copy text-pretty text-neutral-400 dark:text-neutral-100",
							{ "mt-4.5": headline },
						]}
					>
						{subheadline}
					</p>
				)}
			</div>
		)
	}
	<div class="border-t border-tertiary-600 dark:border-neutral-600">
		{
			items.map((item) => (
				<details
					class="group border-b border-tertiary-600 dark:border-neutral-600"
					name={`faq-${blockKey}`}
				>
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4.5 font-serif text-item/item max-md:text-subhead">
						<span>{item.question}</span>
						<span
							class="grid size-7 flex-none place-items-center text-glyph text-secondary-600 group-open:rotate-45 motion-safe:transition-transform motion-safe:duration-450 motion-safe:ease-calm dark:text-secondary-400"
							aria-hidden="true"
						>
							<Icon name="ph:plus" />
						</span>
					</summary>
					<div class="max-w-answer space-y-3 pb-5 text-meta/copy text-pretty text-neutral-400 dark:text-neutral-100">
						{toParagraphs(item.answer).map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</details>
			))
		}
	</div>
</section>

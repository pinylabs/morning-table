---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type SplitBlock = Extract<PageContentBlock, { _type: "marketing_split" }>;
type Props = BlockComponentProps<SplitBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, image, image_caption, image_first } = value;

const paragraphs = toParagraphs(value.body);
const points = (value.points ?? "")
	.split("\n")
	.map((point) => point.trim())
	.filter(Boolean);
const cta =
	value.cta_label && value.cta_url
		? { label: value.cta_label, url: sanitizeHref(value.cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={[
		"scroll-mt-22",
		image
			? "my-section-half bg-primary-700 text-tertiary-300 focus-ring-tertiary-300 dark:bg-primary-950"
			: "py-section-half",
	]}
>
	<div
		class:list={
			image
				? [
						"grid min-h-140 max-md:min-h-0 max-md:grid-cols-1",
						image_first ? "grid-cols-split-flip" : "grid-cols-split",
					]
				: "wrap max-w-intro"
		}
	>
		<div
			class:list={{
				"flex flex-col items-start justify-center px-14 py-18 max-md:px-gutter max-md:py-10": image,
			}}
		>
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 class:list={["headline text-band/heading", { "mt-4": eyebrow }]}>{headline}</h2>
			{
				paragraphs.map((paragraph) => (
					<p
						class:list={[
							"mt-4 max-w-copy text-body/copy text-pretty",
							image ? "text-tertiary-300/80" : "text-neutral-400 dark:text-neutral-100",
						]}
					>
						{paragraph}
					</p>
				))
			}
			{
				points.length > 0 && (
					<ul
						class="mt-6.5 grid gap-2 text-label/note tracking-label text-secondary-600 uppercase dark:text-secondary-400"
						role="list"
					>
						{points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				)
			}
			{
				cta && (
					<a
						href={cta.url}
						class:list={[
							"text-link mt-7.5",
							{ "decoration-tertiary-300/45 hover:decoration-current": image },
						]}
					>
						{cta.label}
						<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
					</a>
				)
			}
		</div>
		{
			image && (
				<figure
					class:list={[
						"settle relative isolate min-h-full overflow-hidden rounded-media max-md:-order-1 max-md:min-h-75",
						{ "-order-1": image_first },
					]}
				>
					<div class="photo-fill absolute inset-0">
						<Image image={image} sizes="(max-width: 767px) 100vw, 60vw" />
					</div>
					{image_caption && <figcaption class="media-chip">{image_caption}</figcaption>}
				</figure>
			)
		}
	</div>
</section>

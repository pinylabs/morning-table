---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type StatsBlock = Extract<PageContentBlock, { _type: "marketing_stats" }>;
type Props = BlockComponentProps<StatsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, stats } = value;
---

<section
	id={anchor_id || undefined}
	class="relative isolate mx-auto my-section-half w-full scroll-mt-22 overflow-hidden rounded-sheet bg-primary-700 text-tertiary-300 focus-ring-tertiary-300 dark:bg-primary-950 dark:inset-ring dark:inset-ring-neutral-600"
>
	<div class="wrap py-section">
		{
			(headline || subheadline) && (
				<h2 class="display mb-stats-gap max-w-stats text-stats-headline/headline">
					{headline}
					{headline && subheadline && " "}
					{subheadline && <span class="text-tertiary-300/80">{subheadline}</span>}
				</h2>
			)
		}
		<dl class="grid grid-cols-stats gap-x-8 gap-y-10 max-tablet:grid-cols-2">
			{
				stats.map((stat) => (
					<div class="flex flex-col-reverse justify-end">
						<dt class="mt-3.5 max-w-label text-detail text-pretty text-tertiary-300/80">{stat.label}</dt>
						<dd class="font-serif text-stat/stat font-normal tracking-tight tabular-nums wrap-anywhere max-tablet:text-stat-sm">
							{stat.value}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

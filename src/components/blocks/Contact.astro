---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type ContactBlock = Extract<PageContentBlock, { _type: "marketing_contact" }>;
type Props = BlockComponentProps<ContactBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, options } = value;
const OptionHeading = headline ? "h3" : "h2";

const iconMap: Record<string, string> = {
	email: "ph:envelope",
	support: "ph:lifebuoy",
	sales: "ph:currency-dollar",
	phone: "ph:phone",
	chat: "ph:chat-circle",
	location: "ph:map-pin",
};
---

<section id={anchor_id || undefined} class="wrap scroll-mt-22 py-section-half">
	{
		(eyebrow || headline || subheadline) && (
			<header class="mx-auto mb-header max-w-intro text-center">
				{eyebrow && <p class="eyebrow">{eyebrow}</p>}
				{headline && <h2 class:list={["headline", { "mt-4.5": eyebrow }]}>{headline}</h2>}
				{subheadline && (
					<p class="mt-4.5 text-body/copy text-pretty text-neutral-400 dark:text-neutral-100">
						{subheadline}
					</p>
				)}
			</header>
		)
	}
	<ul
		class:list={[
			"grid gap-x-10 gap-y-9",
			options.length === 1 ? "grid-cols-single justify-center" : "grid-cols-contact",
		]}
		role="list"
	>
		{
			options.map((option) => (
				<li class="flex flex-col items-start border-t border-tertiary-600 pt-5.5 dark:border-neutral-600">
					<span
						class="grid flex-none place-items-center text-subhead text-secondary-600 dark:text-secondary-400"
						aria-hidden="true"
					>
						<Icon name={iconMap[option.icon] ?? "ph:envelope"} />
					</span>
					<OptionHeading class="mt-3.5 text-item/item tracking-normal">{option.title}</OptionHeading>
					{toParagraphs(option.description).map((paragraph) => (
						<p class="mt-1.5 text-meta/copy text-pretty text-neutral-400 dark:text-neutral-100">
							{paragraph}
						</p>
					))}
					<div class="mt-auto max-w-full pt-5">
						<a
							class="text-link max-w-full text-meta tracking-normal normal-case wrap-anywhere"
							href={sanitizeHref(option.link_url)}
						>
							{option.link_label}
							<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
						</a>
					</div>
				</li>
			))
		}
	</ul>
</section>

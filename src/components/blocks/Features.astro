---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type FeaturesBlock = Extract<PageContentBlock, { _type: "marketing_features" }>;
type Props = BlockComponentProps<FeaturesBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, features } = value;

// The café writes a dish as "Flat white · 5.0": the part after the last " · " is its
// price when it holds a figure. A title without one is shown whole, with no price.
// The block's icons are not drawn; the café's menu is words and prices only.
const PRICED = /^(.*\S)\s+·\s+([^\s·]*\d[^\s·]*)$/;
const dishes = features.map((feature) => {
	const priced = PRICED.exec(feature.title.trim());
	return {
		name: priced ? priced[1] : feature.title,
		price: priced ? priced[2] : undefined,
		notes: toParagraphs(feature.description),
	};
});
---

<section id={anchor_id || undefined} class="scroll-mt-22 py-section-half">
	<div class="wrap grid grid-cols-menu items-start gap-20 max-md:grid-cols-1 max-md:gap-7">
		<header>
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 class:list={["headline", { "mt-4": eyebrow }]}>{headline}</h2>
			{
				subheadline && (
					<p class="mt-4.5 max-w-lede text-body/copy text-pretty text-neutral-400 dark:text-neutral-100">
						{subheadline}
					</p>
				)
			}
		</header>
		<dl class="border-t border-tertiary-600 dark:border-neutral-600">
			{
				dishes.map((dish) => (
					<div class="fade grid grid-cols-row gap-x-4.5 gap-y-1 border-b border-tertiary-600 py-4.5 dark:border-neutral-600">
						<dt class="col-start-1 font-serif text-item/item">{dish.name}</dt>
						{dish.price && (
							<dd class="col-start-2 row-start-1 self-center text-meta text-secondary-600 tabular-nums dark:text-secondary-400">
								{dish.price}
							</dd>
						)}
						{dish.notes.map((note) => (
							<dd class="col-start-1 text-small/note text-pretty text-neutral-400 dark:text-neutral-100">
								{note}
							</dd>
						))}
					</div>
				))
			}
		</dl>
	</div>
</section>

---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="wrap empty-state">
		<p class="display text-giant/flush tracking-title text-neutral-300 dark:text-neutral-200">404</p>
		<h1 class="headline">Page not found</h1>
		<p class="lead">
			This room is empty. The page you’re looking for doesn’t exist or has moved.
		</p>
		<div class="mt-3 flex flex-wrap justify-center gap-2.5">
			<a href="/" class="btn btn-lg btn-primary">Go home</a>
			<a href="/visit" class="btn btn-lg btn-secondary">How to find us</a>
		</div>
	</section>
</Base>

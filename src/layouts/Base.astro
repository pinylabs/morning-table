---
import { Icon } from "astro-iconset/components";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveSiteIdentity } from "../utils/site";
import PinyStudio from "../components/PinyStudio.astro";
import { photoCredits } from "../utils/credits";
import "../styles/global.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, content } = Astro.props;
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const { siteTitle, siteTagline, siteLogo, titleSeparator } = resolveSiteIdentity(
	settingsResult.data,
);
const fullTitle = title
	? title.includes(siteTitle)
		? title
		: `${title} ${titleSeparator} ${siteTitle}`
	: siteTitle;
const WHITESPACE = /\s+/;
const menuItems = menuResult.data?.items ?? [];
const isButtonItem = (item: (typeof menuItems)[number]) =>
	item.cssClasses?.split(WHITESPACE).includes("button") ?? false;
const navLinks = menuItems.filter((item) => !isButtonItem(item));
const navButtons = menuItems.filter(isButtonItem);
const panelButtons = navButtons.slice(1);

const footerColumns = [footerProductResult, footerCompanyResult, footerSupportResult]
	.map((result) => ({ heading: result.data?.label, items: result.data?.items ?? [] }))
	.filter((column) => column.items.length > 0);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || undefined,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const hasMenuPanel = navLinks.length > 0 || panelButtons.length > 0 || isLoggedIn;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..600;1,400..600&family=Karla:wght@400..600&display=swap"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col leading-copy">
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<header
			data-site-header
			class="sticky top-0 z-50 bg-tertiary-200/92 shadow-rule backdrop-blur-glass dark:bg-neutral-900/90 dark:shadow-neutral-600 over-photo:absolute over-photo:inset-x-0 over-photo:top-0 over-photo:bg-transparent over-photo:text-tertiary-100 over-photo:shadow-none over-photo:backdrop-blur-none over-photo:text-shadow-photo over-photo:focus-ring-tertiary-100"
		>
			<div
				class="relative flex h-21 items-center gap-7 px-gutter text-small tracking-nav uppercase max-tablet:gap-3"
			>
				<a
					href="/"
					class="me-auto min-w-0 overflow-hidden font-serif text-wordmark/control tracking-mark text-ellipsis whitespace-nowrap normal-case italic"
				>
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								width={siteLogo.width}
								height={siteLogo.height}
								class="h-9 w-auto max-w-45 object-contain"
							/>
						) : (
							siteTitle
						)
					}
				</a>
				{
					navLinks.length > 0 && (
						<nav class="flex gap-7 max-tablet:hidden" aria-label="Primary">
							{navLinks.map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									class="whitespace-nowrap underline decoration-transparent underline-offset-6 transition-colors duration-200 hover:decoration-current"
								>
									{item.label}
								</a>
							))}
						</nav>
					)
				}
				<div class="flex flex-none items-center gap-2.5">
					{
						isLoggedIn && (
							<a
								href="/_emdash/admin"
								class="px-1.5 text-tag opacity-70 transition-opacity hover:opacity-100 max-tablet:hidden"
							>
								Admin
							</a>
						)
					}
					{navButtons.map((item, index) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							class:list={[
								"btn btn-sm whitespace-nowrap text-inherit inset-ring inset-ring-current hover:bg-neutral-700 hover:text-tertiary-200 hover:text-shadow-none dark:hover:bg-tertiary-500 dark:hover:text-neutral-900 over-photo:inset-ring-tertiary-100/70 over-photo:hover:bg-tertiary-100 over-photo:hover:text-neutral-700",
								{ "max-tablet:hidden": index > 0 },
							]}
						>
							{item.label}
						</a>
					))}
					{
						hasMenuPanel && (
							<button
								type="button"
								class="group hidden size-10 cursor-pointer place-items-center rounded-pill text-subhead transition-colors hover:bg-current/12 aria-expanded:bg-current/12 max-tablet:grid"
								aria-expanded="false"
								aria-controls="mobile-menu"
								aria-label="Menu"
							>
								<Icon name="ph:list" class="group-aria-expanded:hidden" aria-hidden="true" />
								<Icon name="ph:x" class="group-not-aria-expanded:hidden" aria-hidden="true" />
							</button>
						)
					}
				</div>
				{
					hasMenuPanel && (
						<nav
							id="mobile-menu"
							class="absolute inset-x-gutter top-full hidden max-h-panel overflow-y-auto bg-tertiary-50 px-4.5 py-1 text-neutral-700 ring ring-tertiary-600 text-shadow-none max-tablet:grid dark:bg-neutral-800 dark:text-tertiary-500 dark:ring-neutral-600"
							aria-label="Primary"
							hidden
						>
							{[...navLinks, ...panelButtons].map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									class="flex min-h-13 items-center border-b border-tertiary-600 text-small transition-colors last:border-b-0 hover:text-secondary-600 dark:border-neutral-600 dark:hover:text-secondary-400"
								>
									{item.label}
								</a>
							))}
							{isLoggedIn && (
								<a
									href="/_emdash/admin"
									class="flex min-h-13 items-center text-small text-neutral-300 transition-colors hover:text-secondary-600 dark:text-neutral-200 dark:hover:text-secondary-400"
								>
									Admin
								</a>
							)}
						</nav>
					)
				}
			</div>
		</header>

		<main id="main" tabindex="-1" class="flex-1 scroll-mt-22 focus:outline-none">
			<slot />
		</main>

		<footer class="border-t border-tertiary-600 pt-12 pb-11 dark:border-neutral-600">
			<div class="wrap">
				<div
					class="grid grid-flow-col auto-cols-fr grid-cols-footer gap-10 max-tablet:grid-flow-row max-tablet:grid-cols-2 max-tablet:gap-x-6 max-tablet:gap-y-9"
				>
					<div class="max-tablet:col-span-full">
						<a href="/" class="inline-block font-serif text-wordmark/control tracking-mark italic">
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										width={siteLogo.width}
										height={siteLogo.height}
										class="h-9 w-auto max-w-45 object-contain"
									/>
								) : (
									siteTitle
								)
							}
						</a>
						{
							siteTagline && (
								<p class="mt-3 max-w-tagline text-small/note text-neutral-400 dark:text-neutral-100">
									{siteTagline}
								</p>
							)
						}
					</div>
					{
						footerColumns.map((column) => (
							<div>
								{column.heading && <h2 class="eyebrow mb-3.5 block text-caption">{column.heading}</h2>}
								<ul class="grid gap-2">
									{column.items.map((item) => (
										<li>
											<a
												href={item.url}
												target={item.target}
												rel={item.target ? "noopener noreferrer" : undefined}
												class="text-small text-neutral-400 underline decoration-transparent underline-offset-4 wrap-anywhere transition-colors hover:text-neutral-700 hover:decoration-tertiary-700 dark:text-neutral-100 dark:hover:text-tertiary-500 dark:hover:decoration-neutral-500"
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
				<div
					class="mt-11 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-tertiary-600 pt-5.5 text-caption/loose text-neutral-400 dark:border-neutral-600 dark:text-neutral-100"
				>
					<p>&copy; {year} {siteTitle}. All rights reserved.</p>
					<div class="inline-flex gap-4" role="group" aria-label="Theme">
						{
							[
								["light", "Light", "Light mode"],
								["dark", "Dark", "Dark mode"],
								["system", "System", "System theme"],
							].map(([theme, label, name]) => (
								<button
									type="button"
									class="cursor-pointer text-caption tracking-label text-neutral-400 uppercase underline decoration-transparent underline-offset-5 transition-colors hover:text-neutral-700 aria-pressed:text-neutral-700 aria-pressed:decoration-secondary-600 forced-colors:aria-pressed:outline dark:text-neutral-100 dark:hover:text-tertiary-500 dark:aria-pressed:text-tertiary-500 dark:aria-pressed:decoration-secondary-400"
									data-theme={theme}
									aria-pressed="false"
									aria-label={name}
								>
									{label}
								</button>
							))
						}
					</div>
					<p>
						Powered by <a
							href="https://emdashcms.com"
							class="text-neutral-700 underline decoration-tertiary-600 underline-offset-3 transition-colors hover:decoration-current dark:text-tertiary-500 dark:decoration-neutral-600 dark:hover:decoration-current"
							>EmDash</a
						>
					</p>
				</div>
				<div
					class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-caption/loose text-neutral-400 dark:text-neutral-100"
				>
					<p>
						Photos on Unsplash by {
						photoCredits.map((credit, index) => (
							<>
								{index > 0 && ", "}
								<a
									href={credit.url}
									class="underline decoration-tertiary-600 dark:decoration-neutral-600"
								>
									{credit.name}
								</a>
							</>
						))
					}.
					</p>
					<p>Made by the Pinies in <PinyStudio markSize="size-4" /></p>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>("button[data-theme]");
			const root = document.documentElement;

			function setTheme(theme: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.setAttribute("aria-pressed", String(btn.dataset.theme === theme));
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize - apply stored theme on load
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<script>
			const header = document.querySelector<HTMLElement>("[data-site-header]");
			const menuButton = header?.querySelector<HTMLButtonElement>(
				'button[aria-controls="mobile-menu"]',
			);
			const menuPanel = header?.querySelector<HTMLElement>("#mobile-menu");

			if (header && menuButton && menuPanel) {
				const setOpen = (open: boolean) => {
					menuButton.setAttribute("aria-expanded", String(open));
					menuPanel.hidden = !open;
				};

				menuButton.addEventListener("click", () =>
					setOpen(menuButton.getAttribute("aria-expanded") !== "true"),
				);

				menuPanel.addEventListener("click", (event) => {
					if (event.target instanceof Element && event.target.closest("a")) {
						setOpen(false);
					}
				});

				document.addEventListener("click", (event) => {
					if (
						!menuPanel.hidden &&
						event.target instanceof Node &&
						!header.contains(event.target)
					) {
						setOpen(false);
					}
				});

				document.addEventListener("keydown", (event) => {
					if (event.key !== "Escape" || menuPanel.hidden) return;
					setOpen(false);
					menuButton.focus();
				});

				header.addEventListener("focusout", (event) => {
					if (
						event.relatedTarget instanceof Node &&
						!header.contains(event.relatedTarget)
					) {
						setOpen(false);
					}
				});

				window
					.matchMedia("(max-width: 960px)")
					.addEventListener("change", (event) => {
						if (!event.matches) setOpen(false);
					});
			}
		</script>
	</body>
</html>
